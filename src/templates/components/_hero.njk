<section
  id="home"
  class="hero-box position-relative border mx-3 mx-md-4 mt-3 d-flex flex-column mt-md-5"
  style="min-height: 88vh"
>
  <div class="spotlight" id="spotlight"></div>

  <div class="container-fluid px-4 px-md-5 py-4 d-flex flex-column flex-grow-1">
    <div
      class="d-flex justify-content-between align-items-center flex-wrap gap-2 font-mono text-uppercase small text-secondary"
    >
      <span
        class="d-inline-flex align-items-center gap-2 border rounded-pill px-3 py-1"
      >
        <span class="status-dot"></span> NOT Available for work
      </span>
      <span
        >Semarang, ID <span class="text-muted">/</span>
        <span id="clock">--:--:--</span> WIB</span
      >
    </div>

    <!-- name -->
    <div class="name-wrap mt-4 mt-md-5">
      <h1
        class="name-ghost font-display fw-bold display-fluid m-0"
        aria-hidden="true"
      >
        {{ companyName }}
      </h1>
      <h1 class="name-solid font-display fw-bold display-fluid m-0">
        {{ companyName }}
      </h1>
    </div>

    <!-- role -->
    <p class="mt-3 fs-5 text-secondary">
      Building
      <span
        id="role-text"
        class="text-dark fw-medium border-bottom border-dark pb-1"
        >interfaces</span
      ><span class="caret"></span> — one clean line of code at a time.
    </p>

    <!-- CTA + stats -->
    <div
      class="d-flex justify-content-between align-items-end flex-wrap gap-4 mt-4 mt-md-5"
    >
      <div class="d-flex gap-2 flex-wrap">
        <a href="/projects" class="btn btn-dark rounded-pill px-4 py-2"
          >View Work ↗</a
        >
        <a href="#contact" class="btn btn-outline-dark rounded-pill px-4 py-2"
          >Get in Touch</a
        >
      </div>
      <div class="d-flex gap-4">
        <div>
          <span class="d-block font-display fw-bold fs-3"
            >{{ cprojects }}+</span
          >
          <span class="font-mono text-uppercase small text-secondary"
            >Projects</span
          >
        </div>
        <div>
          <span class="d-block font-display fw-bold fs-3">{{ exp }}</span>
          <span class="font-mono text-uppercase small text-secondary"
            >Years</span
          >
        </div>
        <div>
          <span class="d-block font-display fw-bold fs-3">10%</span>
          <span class="font-mono text-uppercase small text-secondary"
            >Client focus</span
          >
        </div>
      </div>
    </div>

    <!-- marquee -->
    <div class="marquee-wrap border-top mt-4 mt-md-5 py-3">
      <div
        class="marquee-track font-mono text-uppercase small text-secondary"
        id="marquee"
      >
        <span class="d-flex align-items-center gap-4">
          <b class="text-dark fw-medium">Backend Development</b> · Junior ML
          Development · <b class="text-dark fw-medium">Junior Bootstrap</b> ·
          JavaScript DOM · <b class="text-dark fw-medium">Design Systems</b> ·
          Web Performance ·
        </span>
        <span class="d-flex align-items-center gap-4">
          <b class="text-dark fw-medium">Backend Development</b> · Junior ML
          Development · <b class="text-dark fw-medium">Junior Bootstrap</b> ·
          JavaScript DOM · <b class="text-dark fw-medium">Design Systems</b> ·
          Web Performance ·
        </span>
      </div>
    </div>

    <!-- bottom row -->
    <div
      class="d-flex justify-content-between align-items-center border-top pt-3 mt-auto flex-wrap gap-2"
    >
      <div class="d-flex gap-3 font-mono small text-secondary">
        <a
          href="https://github.com/{{ social.Github }}"
          class="link-underline-grow text-secondary"
          target="_blank"
          rel="noopener nofollow"
          >GitHub</a
        >
        <a
          href="#"
          class="link-underline-grow text-secondary"
          target="_blank"
          rel="noopener nofollow"
          >LinkedIn</a
        >
        <a
          href="https://instagram.com/{{ social.Instagram }}"
          class="link-underline-grow text-secondary"
          target="_blank"
          rel="noopener nofollow"
          >Instagram</a
        >
        <a
          href="mailto:{{ email|safe }}"
          class="link-underline-grow text-secondary"
          >Email</a
        >
      </div>
      <div class="font-mono text-uppercase small text-secondary">
        Scroll <span class="bob">↓</span>
      </div>
    </div>
  </div>
</section>
