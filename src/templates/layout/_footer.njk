<footer class="site-footer">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-5">
        <div class="footer-brand">
          <h2 class="footer-title">{{ site.companyName }}</h2>

          <p class="footer-description">
            We build reliable digital solutions that help ideas grow into useful
            products.
          </p>

          <div class="social-links" aria-label="Social media">
            <a href="#" aria-label="Facebook">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="#" aria-label="Twitter">
              <i class="fab fa-twitter"></i>
            </a>
            <a href="#" aria-label="Instagram">
              <i class="fab fa-instagram"></i>
            </a>
            <a href="#" aria-label="LinkedIn">
              <i class="fab fa-linkedin-in"></i>
            </a>
            <a href="#" aria-label="YouTube">
              <i class="fab fa-youtube"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="col-6 col-md-3 col-lg-2">
        <h3 class="footer-heading">Explore</h3>

        <ul class="footer-links">
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div class="col-6 col-md-3 col-lg-2">
        <h3 class="footer-heading">Resources</h3>

        <ul class="footer-links">
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/support">Support</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="col-lg-3">
        <h3 class="footer-heading">Stay Updated</h3>

        <p class="footer-description">
          Get occasional updates about new projects, releases, and useful
          resources.
        </p>

        <form action="/newsletter" method="post" class="newsletter-form">
          <label for="newsletter-email" class="visually-hidden">
            Email address
          </label>

          <div class="input-group">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              class="form-control newsletter-input"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />

            <button
              class="btn btn-subscribe"
              type="submit"
              aria-label="Subscribe to newsletter"
            >
              Subscribe
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container-fluid">
      <div class="row align-items-center gy-2">
        <div class="col-md-6">
          <p class="footer-copyright mb-0">
            &copy; 2026 {{ site.companyName }}. All rights reserved.
          </p>
        </div>

        <div class="col-md-6 text-md-end">
          <p class="footer-credit mb-0">
            Built with <i class="fas fa-heart text-danger"></i> by
            <a href="/about">{{ site.companyName }}</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
